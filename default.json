{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 9-18 * * 0,6"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "github-actions": {
    "pinDigests": true
  },
  "packageRules": [
    {
      "matchCategories": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python minor and patch"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm minor and patch"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "docker minor and patch"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "github-actions minor and patch"
    },
    {
      "matchManagers": [
        "helmv3",
        "helm-values"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "helm minor and patch"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go minor and patch"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "rust minor and patch"
    },
    {
      "matchManagers": [
        "bundler"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "ruby minor and patch"
    },
    {
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "java minor and patch"
    },
    {
      "description": "Automerge minor/patch ONLY in repos that have required status checks on the default branch (branch protection). Digest/pinDigest bumps are deliberately NOT automerged - they need human review. Extend matchRepositories as protection rolls out.",
      "matchRepositories": [
        "first-it-consulting/harness-control-center",
        "first-it-consulting/llm-gateway-proxy",
        "first-it-consulting/claude-bridge"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
